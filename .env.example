# =============================================================================
# SDLC Environment Configuration - Riya Group E-commerce
# =============================================================================
# Copy this file to .env and configure for your environment
# Different configurations for: development, staging, production

# =============================================================================
# ENVIRONMENT CONFIGURATION
# =============================================================================
DJANGO_SETTINGS_MODULE=ecommerce.settings.development
DEBUG=True
ENVIRONMENT=development

# =============================================================================
# SECURITY CONFIGURATION (SDLC Security Requirements)
# =============================================================================
# CRITICAL: Generate a strong SECRET_KEY for production (50+ characters)
SECRET_KEY=django-insecure-CHANGE-THIS-IN-PRODUCTION-3e1s4+9^0+3cl!a+3$yta5r$*@iig(5@@at$_!@4oxp)e+#7o%

# Production security settings (enable for production)
SECURE_SSL_REDIRECT=False
SECURE_HSTS_SECONDS=0
SESSION_COOKIE_SECURE=False
CSRF_COOKIE_SECURE=False

# =============================================================================
# DATABASE CONFIGURATION
# =============================================================================
# Development: SQLite (default)
DATABASE_URL=sqlite:///db.sqlite3

# Production: PostgreSQL (recommended)
# DATABASE_URL=postgresql://username:password@localhost:5432/riyagroup_db
# DB_NAME=riyagroup_db
# DB_USER=riyagroup_user
# DB_PASSWORD=secure_password_here
# DB_HOST=localhost
# DB_PORT=5432

# =============================================================================
# PAYMENT GATEWAY CONFIGURATION (SDLC Integration)
# =============================================================================
# Stripe keys (use test keys for development)
STRIPE_PUBLISHABLE_KEY=pk_test_your_test_key_here
STRIPE_SECRET_KEY=sk_test_your_test_key_here

# Production Stripe keys (live keys for production)
# STRIPE_PUBLISHABLE_KEY=pk_live_your_live_key_here
# STRIPE_SECRET_KEY=sk_live_your_live_key_here

# =============================================================================
# EMAIL CONFIGURATION (SDLC Communication)
# =============================================================================
# Development: Console/File backend
EMAIL_BACKEND=django.core.mail.backends.console.EmailBackend

# Production: SMTP configuration
# EMAIL_BACKEND=django.core.mail.backends.smtp.EmailBackend
# EMAIL_HOST=smtp.gmail.com
# EMAIL_PORT=587
# EMAIL_USE_TLS=True
# EMAIL_HOST_USER=noreply@riyagroup.com
# EMAIL_HOST_PASSWORD=your_app_password_here
# DEFAULT_FROM_EMAIL=Riya Group <noreply@riyagroup.com>

# =============================================================================
# CACHING CONFIGURATION (SDLC Performance)
# =============================================================================
# Redis for caching and sessions
REDIS_URL=redis://127.0.0.1:6379/1

# =============================================================================
# STATIC FILES & MEDIA (SDLC Asset Management)
# =============================================================================
# AWS S3 for production static/media files
USE_S3=False
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_STORAGE_BUCKET_NAME=riyagroup-static
AWS_S3_REGION_NAME=us-east-1

# =============================================================================
# MONITORING & ANALYTICS (SDLC Monitoring)
# =============================================================================
# Sentry for error tracking
SENTRY_DSN=

# Google Analytics
GOOGLE_ANALYTICS_ID=

# Facebook Pixel
FACEBOOK_PIXEL_ID=

# =============================================================================
# DEPLOYMENT CONFIGURATION (SDLC Deployment)
# =============================================================================
# Allowed hosts (production)
ALLOWED_HOSTS=localhost,127.0.0.1,riyagroup.com,www.riyagroup.com

# =============================================================================
# DEVELOPMENT/TESTING CONFIGURATION
# =============================================================================
# Test database for CI/CD
TEST_DATABASE_URL=sqlite:///test_db.sqlite3

# Coverage reporting
COVERAGE_RCFILE=.coveragerc

# =============================================================================
# FEATURE FLAGS (SDLC Feature Management)
# =============================================================================
# Enable/disable features for gradual rollout
ENABLE_ANALYTICS=True
ENABLE_RECOMMENDATIONS=False
ENABLE_REVIEWS=True
ENABLE_WISHLIST=False

# =============================================================================
# API KEYS & INTEGRATIONS (SDLC Third-party)
# =============================================================================
# Social media API keys
FACEBOOK_APP_ID=
FACEBOOK_APP_SECRET=
TWITTER_API_KEY=
TWITTER_API_SECRET=

# SMS/Notification services
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_PHONE_NUMBER=

# =============================================================================
# SDLC ENVIRONMENT VALIDATION
# =============================================================================
# Validation settings for different environments
REQUIRE_EMAIL_VERIFICATION=False
ENABLE_DEBUG_TOOLBAR=True
LOG_LEVEL=DEBUG

# =============================================================================
# NOTES:
# - Never commit this file with real credentials
# - Use environment-specific .env files
# - Validate all settings before deployment
# - Follow SDLC security best practices
# =============================================================================
